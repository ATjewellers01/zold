# Server Configuration
PORT=5001
NODE_ENV=development

# ─── Database: AWS RDS Postgres ───
# Database names are CASE-SENSITIVE in the URL path.
# sslmode=no-verify is required when rds.force_ssl=1 and the RDS CA is not in
# Node's trust store. Note: sslmode=require FAILS in node-pg (aliases to
# verify-full); use no-verify, or supply the RDS CA bundle explicitly.
# Percent-encode special characters in the password (@ -> %40).
# No pooler in front of plain RDS, so both URLs are the same. If you add RDS
# Proxy, point DATABASE_URL at the proxy and keep DIRECT_URL on the instance —
# migrations need a session-mode (non-transaction-pooled) connection.
DATABASE_URL="postgresql://USER:PASSWORD@your-instance.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/YourDb?sslmode=no-verify"
DIRECT_URL="postgresql://USER:PASSWORD@your-instance.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/YourDb?sslmode=no-verify"

# ─── Supabase: Storage only (profile images), not the database ───
# Variable name must be SUPABASE_SERVICE_ROLE_KEY — that is what
# src/config/supabase.ts reads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-secret

# Resend (transactional email)
RESEND_API_KEY=your-resend-api-key

# Metal price APIs
GOLD_API_KEY=your-goldapi-key
SILVER_API_KEY=your-goldapi-key

# Gold News API (100 requests/day limit)
GNEWS_API_KEY=your-gnews-token

# USD to INR exchange rate API
EXCHANGE_RATE_API_KEY=your-exchangerate-key

# Razorpay credentials
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Optional — referenced by the code where set
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
