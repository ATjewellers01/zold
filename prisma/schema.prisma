generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(uuid())
  name                 String
  username             String                 @unique
  email                String                 @unique
  password             String
  role                 Role                   @default(USER)
  isVerified           Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  otp                  String?
  otpExpiry            DateTime?
  phone                String                 @unique
  riskLevel            String                 @default("LOW")
  dataSharing          Boolean                @default(false)
  profileVisibility    String                 @default("contacts")
  readReceipts         Boolean                @default(true)
  twoFactorEnabled     Boolean                @default(false)
  adminRole            AdminRoleType?
  referralCode         String?                @unique
  profilePicture       String?
  bankAccounts         BankAccount[]
  cart                 Cart?
  coinInventory        CoinInventory[]
  coinPurchaseSessions CoinPurchaseSession[]
  coinTransactions     CoinTransaction[]
  metalGoals           MetalGoal[]
  gstConfigs           GstConfig[]            @relation("AdminGstConfigs")
  kyc                  Kyc?
  lockedCart           LockedCart[]
  receivedGifts        MetalGift[]            @relation("ReceivedGifts")
  sentGifts            MetalGift[]            @relation("SentGifts")
  metalPurchaseSession MetalPurchaseSession[]
  metalRate            MetalRate[]
  metalTransactions    MetalTransaction[]
  notifications        Notification[]
  partner              Partner?
  paymentMethods       PaymentMethod[]
  referredBy           Referral?              @relation("ReferredUser")
  referrals            Referral[]             @relation("Referrer")
  savedAddresses       SavedAddress[]
  userSip              UserSip[]
  SipTransaction       SipTransaction[]
  sessions             UserSession[]
  inventory            Inventory?
}

model Inventory {
  id            String   @id @default(uuid())
  userId        String   @unique
  goldBalance   Decimal  @default(0) @db.Decimal(10, 3)
  silverBalance Decimal  @default(0) @db.Decimal(10, 3)
  rupeeBalance  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pledgedGold   Decimal  @default(0) @db.Decimal(10, 3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Kyc {
  id              String        @id @default(uuid())
  userId          String        @unique
  status          KycStatus     @default(PENDING)
  panNumber       String?
  aadhaarNumber   String?
  bankName        String?
  accountNumber   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       KycDocument[]
}

model MetalTransaction {
  id                  String                @id @default(uuid())
  user_id             String
  session_id          String?               @unique
  metalType           Metal
  transactionType     TransactionType
  metalGrams          Decimal               @db.Decimal(10, 3)
  ratePerGram         Decimal               @db.Decimal(10, 2)
  totalAmount         Decimal               @db.Decimal(10, 2)
  gst                 Decimal               @db.Decimal(10, 2)
  finalAmount         Decimal               @db.Decimal(10, 2)
  paymentMode         PaymentMode
  status              TransactionStatus     @default(PENDING)
  storageType         String?
  purchaseRate        Decimal?              @db.Decimal(10, 2)
  gstRate             Decimal               @default(3) @db.Decimal(5, 2)
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  remark              String?
  createdAt           DateTime              @default(now())
  metalGiftId         String?               @unique
  metalGift           MetalGift?            @relation(fields: [metalGiftId], references: [id])
  session             MetalPurchaseSession? @relation(fields: [session_id], references: [id])
  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([session_id])
  @@index([razorpay_order_id])
}

model MetalPurchaseSession {
  id                  String                @id @default(uuid())
  user_id             String
  metalType           Metal
  transactionType     TransactionType
  metalGrams          Decimal               @db.Decimal(10, 3)
  locked_rate         Decimal               @db.Decimal(10, 2)
  totalAmount         Decimal               @db.Decimal(10, 2)
  gst                 Decimal               @db.Decimal(10, 2)
  gstRate             Decimal               @default(3) @db.Decimal(5, 2)
  finalAmount         Decimal               @db.Decimal(10, 2)
  razorpay_order_id   String?
  razorpay_payment_id String?
  status              PurchaseSessionStatus @default(ACTIVE)
  started_at          DateTime              @default(now())
  expires_at          DateTime
  updated_at          DateTime              @updatedAt
  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction         MetalTransaction?

  @@index([user_id])
  @@index([status])
  @@index([expires_at])
}

model MetalRate {
  id        String   @id @default(uuid())
  metal     Metal
  buyRate   Decimal  @db.Decimal(10, 2)
  sellRate  Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  source    Source
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([metal, createdBy, source, isActive])
  @@index([metal, createdBy, isActive])
}

model BankAccount {
  id                String   @id @default(uuid())
  userId            String
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  accountType       String
  branch            String?
  isPrimary         Boolean  @default(false)
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
}

model PaymentMethod {
  id            String   @id @default(uuid())
  userId        String
  type          String
  provider      String?
  upiId         String?
  cardLast4     String?
  cardNetwork   String?
  expiryMonth   Int?
  expiryYear    Int?
  bankAccountId String?
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  deviceName   String
  deviceType   String
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  userAgent    String?
  token        String   @unique
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model KycDocument {
  id           String   @id @default(uuid())
  kycId        String
  documentType String
  documentUrl  String
  uploadedAt   DateTime @default(now())
  kyc          Kyc      @relation(fields: [kycId], references: [id], onDelete: Cascade)

  @@index([kycId])
}

model Partner {
  id          String    @id @default(uuid())
  business_name String
  owner_name String
  services_offers Services
  area String
  city  String
  full_address String
  pincode String
  timings String
  latitude String
  longitude String
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([id, area, pincode])

}

model MetalGoal {
  id               String     @id @default(uuid())
  userId           String
  metal            Metal
  targetAmount     Decimal    @db.Decimal(10, 2)
  currentAmount    Decimal    @default(0) @db.Decimal(10, 2)
  targetGrams      Decimal    @db.Decimal(10, 3)
  currentGrams     Decimal    @default(0) @db.Decimal(10, 3)
  autoAllocate     Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  status           GoalStatus @default(ACTIVE)
  paymentFrequency Frequency  @default(MONTHLY)
  goalCategory     String
  goalName         String
  targetDate       DateTime
  completionDate   DateTime?
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MetalGift {
  id               String            @id @default(uuid())
  senderId         String
  recipientId      String
  giftType         GiftType          @default(VIRTUAL)
  metalType        Metal
  metalGrams       Decimal?          @db.Decimal(10, 3)
  coinQuantity     Int?
  message          String?
  occasion         String?
  createdAt        DateTime          @default(now())
  status           GiftStatus        @default(COMPLETED)
  coinGrams        Decimal?          @db.Decimal(10, 3)
  recipient        User              @relation("ReceivedGifts", fields: [recipientId], references: [id], onDelete: Cascade)
  sender           User              @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  metalTransaction MetalTransaction?

  @@index([senderId])
  @@index([recipientId])
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  status         String   @default("PENDING")
  rewardAmount   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  referredUser   User     @relation("ReferredUser", fields: [referredUserId], references: [id])
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])

  @@index([referrerId])
}

model CoinInventory {
  id        String   @id @default(uuid())
  userId    String
  metal     Metal
  coinGrams Int
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, coinGrams, metal])
  @@index([userId])
}

model CoinTransaction {
  id                  String               @id @default(uuid())
  user_id             String
  session_id          String?
  metal               Metal
  type                TransactionType
  weight              Int
  quantity            Int
  rate_per_gram       Decimal              @db.Decimal(10, 2)
  gold_locked_price   Decimal?             @db.Decimal(10, 2)
  silver_locked_price Decimal?             @db.Decimal(10, 2)
  gst                 Decimal              @db.Decimal(10, 2)
  gstRate             Decimal              @default(3) @db.Decimal(5, 2)
  final_amount        Decimal              @db.Decimal(10, 2)
  payment_mode        PaymentMode
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  status              TransactionStatus    @default(PENDING)
  remark              String?
  created_at          DateTime             @default(now())
  session             CoinPurchaseSession? @relation(fields: [session_id], references: [id])
  user                User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
  @@index([status])
  @@index([session_id])
  @@index([razorpay_order_id])
}

model CoinPurchaseSession {
  id                  String                @id @default(uuid())
  user_id             String
  started_at          DateTime              @default(now())
  expires_at          DateTime
  status              PurchaseSessionStatus @default(ACTIVE)
  razorpay_order_id   String?
  razorpay_payment_id String?
  gstRate             Decimal               @default(3) @db.Decimal(5, 2)
  updated_at          DateTime              @updatedAt
  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions        CoinTransaction[]
  lockedCart          LockedCart?

  @@index([user_id])
  @@index([status])
  @@index([expires_at])
}

model Cart {
  id         String     @id @default(uuid())
  user_id    String     @unique
  updated_at DateTime   @updatedAt
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id       String @id @default(uuid())
  cart_id  String
  weight   Int
  quantity Int    @default(1)
  metal    Metal
  cart     Cart   @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, weight, metal])
}

model LockedCart {
  id                  String              @id @default(uuid())
  session_id          String              @unique
  user_id             String
  locked_at           DateTime            @default(now())
  gold_locked_price   Decimal             @db.Decimal(10, 2)
  silver_locked_price Decimal             @db.Decimal(10, 2)
  gstRate             Decimal             @default(3) @db.Decimal(5, 2)
  session             CoinPurchaseSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items               LockedCartItem[]

  @@index([user_id])
}

model LockedCartItem {
  id             String     @id @default(uuid())
  locked_cart_id String
  weight         Int
  quantity       Int
  metal          Metal
  item_price     Decimal    @db.Decimal(10, 2)
  lockedCart     LockedCart @relation(fields: [locked_cart_id], references: [id], onDelete: Cascade)

  @@unique([locked_cart_id, weight, metal])
}

model GstConfig {
  id        String   @id @default(uuid())
  rate      Decimal  @db.Decimal(5, 2)
  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  admin     User     @relation("AdminGstConfigs", fields: [updatedBy], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  title      String
  body       String
  data       Json?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([created_at])
}

model Sip {
  id             String           @id @default(uuid())
  name           String
  type           SipType
  metal          Metal
  min_investment Decimal          @default(100.00) @db.Decimal(10, 2)
  created_at     DateTime         @default(now())

  SipTransaction SipTransaction[]
  userSips       UserSip[]
}

model UserSip {
  id                    String   @id @default(uuid())
  sip_id                String
  user_id               String
  metal                 Metal
  investment_amount     Decimal @db.Decimal(10, 2)
  total_invested_amount     Decimal  @db.Decimal(10, 2)
  day_of_month          Int
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  end_date              DateTime?

  @@unique([sip_id, user_id])
  user User @relation(fields: [user_id], references: [id])
  sip  Sip  @relation(fields: [sip_id], references: [id])
}

model SipTransaction {
  id                String  @id @default(uuid())
  sip_id            String
  user_id           String
  metal             Metal
  investment_amount Decimal @db.Decimal(10, 2)
  gst               Decimal @db.Decimal(5, 2)
  total_amount      Decimal @db.Decimal(10, 2)

  status              TransactionStatus
  razorpay_order_id   String
  razorpay_payment_id String
  razorpay_signature  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
  sip  Sip  @relation(fields: [sip_id], references: [id])
}

enum Source {
  ADMIN
  LIVE
}

enum Frequency {
  MONTHLY
  QUATERLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum GiftType {
  COIN
  VIRTUAL
}

enum GiftStatus {
  COMPLETED
  FAILED
}

enum Role {
  ADMIN
  USER
  PARTNER
}

enum AdminRoleType {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  LOAN_ADMIN
  SUPPORT_ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  BUY
  SELL
  GIFT
}

enum PaymentMode {
  RAZORPAY
  WALLET
  UPI
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
  REFUNDED
}

enum PurchaseSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum Metal {
  GOLD
  SILVER
}

enum SipFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum SipStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum SipTransactionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum SipType {
  REGULAR
}

enum Services {
  JEWELLERY
  PICKUP
  LOAN
}