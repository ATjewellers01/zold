generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  name              String
  username          String            @unique
  email             String            @unique
  password          String
  role              Role              @default(USER)
  isVerified        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  otp               String?
  otpExpiry         DateTime?
  phone             String?
  riskLevel         String            @default("LOW")
  dataSharing       Boolean           @default(false)
  profileVisibility String            @default("contacts")
  readReceipts      Boolean           @default(true)
  twoFactorEnabled  Boolean           @default(false)
  adminRole         AdminRoleType?
  bankAccounts      BankAccount[]
  goldTransactions  GoldTransaction[]
  kyc               Kyc?
  partner           Partner?
  paymentMethods    PaymentMethod[]
  savedAddresses    SavedAddress[]
  testWallet        TestWallet?
  sessions          UserSession[]
  wallet            Wallet?
  goldGoals         GoldGoal[]
  sentGifts         GoldGift[]   @relation("SentGifts")
  receivedGifts     GoldGift[]   @relation("ReceivedGifts")
  referralCode      String?      @unique
  referredBy        Referral?    @relation("ReferredUser")
  referrals         Referral[]   @relation("Referrer")
  coinInventory     CoinInventory[]
  coinTransactions  CoinTransaction[]
  sellGoldRequests  SellGoldRequest[]
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  goldBalance  Float    @default(0)
  rupeeBalance Decimal  @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pledgedGold  Float    @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Kyc {
  id              String        @id @default(uuid())
  userId          String        @unique
  status          KycStatus     @default(PENDING)
  panNumber       String?
  aadhaarNumber   String?
  bankName        String?
  accountNumber   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       KycDocument[]
}

model TestWallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  virtualBalance Decimal  @default(10000) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoldTransaction {
  id           String   @id @default(uuid())
  userId       String
  type         String
  goldGrams    Float
  ratePerGram  Decimal  @db.Decimal(10, 2)
  totalAmount  Decimal  @db.Decimal(10, 2)
  gst          Decimal  @db.Decimal(10, 2)
  finalAmount  Decimal  @db.Decimal(10, 2)
  paymentMode  String
  status       String   @default("COMPLETED")
  storageType  String
  createdAt    DateTime @default(now())
  purchaseRate Decimal? @db.Decimal(10, 2)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoldRate {
  id        String   @id @default(uuid())
  buyRate   Decimal  @db.Decimal(10, 2)
  sellRate  Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  margin    Float    @default(0)
  source    String   @default("MANUAL")
  spread    Float    @default(0)

  @@index([isActive, createdAt])
}

model BankAccount {
  id                String   @id @default(uuid())
  userId            String
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  accountType       String
  branch            String?
  isPrimary         Boolean  @default(false)
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
}

model PaymentMethod {
  id            String   @id @default(uuid())
  userId        String
  type          String
  provider      String?
  upiId         String?
  cardLast4     String?
  cardNetwork   String?
  expiryMonth   Int?
  expiryYear    Int?
  bankAccountId String?
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  deviceName   String
  deviceType   String
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  userAgent    String?
  token        String   @unique
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model KycDocument {
  id           String   @id @default(uuid())
  kycId        String
  documentType String
  documentUrl  String
  uploadedAt   DateTime @default(now())
  kyc          Kyc      @relation(fields: [kycId], references: [id], onDelete: Cascade)

  @@index([kycId])
}

model Partner {
  id          String    @id @default(uuid())
  name        String
  area        String
  city        String
  state       String    @default("Chhattisgarh")
  country     String    @default("India")
  latitude    Float
  longitude   Float
  distance    Float     @default(0)
  phone       String
  email       String?
  website     String?
  rating      Float     @default(0)
  reviews     Int       @default(0)
  timings     String
  services    String
  offers      String    @default("[]")
  description String?
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bankAccount String?
  commission  Float     @default(0)
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])

  @@index([city])
  @@index([isActive])
  @@index([userId])
}

enum Role {
  ADMIN
  USER
  PARTNER
}

enum AdminRoleType {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  LOAN_ADMIN
  SUPPORT_ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model GoldGoal {
  id            String   @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal  @db.Decimal(10, 2)
  currentAmount Decimal  @default(0) @db.Decimal(10, 2)
  targetGrams   Float
  currentGrams  Float    @default(0)
  deadline      DateTime
  category      String
  icon          String
  color         String
  autoAllocate  Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoldGift {
  id              String    @id @default(uuid())
  senderId        String
  recipientId     String?   // Set when gift is claimed
  recipientName   String
  recipientPhone  String
  giftType        String    @default("rupees") // "rupees", "grams", "coins"
  amount          Decimal   @db.Decimal(10, 2)
  goldGrams       Float
  coinGrams       Int?      // Coin denomination (1, 2, 5, 10) if coin gift
  coinQuantity    Int?      // Number of coins if coin gift
  message         String?
  occasion        String
  status          String    @default("PENDING") // PENDING, CLAIMED, EXPIRED
  claimedAt       DateTime? // When the gift was claimed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sender          User      @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  recipient       User?     @relation("ReceivedGifts", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([recipientId])
  @@index([recipientPhone])
}

model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  referredUserId  String   @unique
  status          String   @default("PENDING") // PENDING, COMPLETED (Purchase made)
  rewardAmount    Decimal  @default(0) @db.Decimal(10, 2) // Amount earned by referrer
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  referrer        User     @relation("Referrer", fields: [referrerId], references: [id])
  referredUser    User     @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@index([referrerId])
}

// Gold Coin Inventory - tracks user's physical gold coin holdings
model CoinInventory {
  id        String   @id @default(uuid())
  userId    String
  coinGrams Int      // 1, 2, 5, or 10 grams
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, coinGrams])
  @@index([userId])
}

// Gold Coin Transaction - tracks coin purchases and conversions
model CoinTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // BUY_WITH_RUPEES, CONVERT_FROM_GOLD
  coinGrams   Int      // 1, 2, 5, or 10 grams
  quantity    Int      // number of coins
  ratePerGram Decimal  @db.Decimal(10, 2)
  goldValue   Decimal  @db.Decimal(10, 2) // coinGrams * quantity * ratePerGram
  gst         Decimal  @db.Decimal(10, 2)
  finalAmount Decimal  @db.Decimal(10, 2) // goldValue + gst (for rupee purchase)
  paymentMode String   // TEST_WALLET, WALLET_GOLD
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Sell Gold Request - requires admin approval before wallet credit
model SellGoldRequest {
  id              String            @id @default(uuid())
  userId          String
  goldGrams       Float
  ratePerGram     Decimal           @db.Decimal(10, 2)
  grossAmount     Decimal           @db.Decimal(10, 2)
  gst             Decimal           @db.Decimal(10, 2)
  netAmount       Decimal           @db.Decimal(10, 2)
  paymentMethod   String            // "bank", "card", "wallet", "credit"
  bankAccountId   String?
  paymentMethodId String?
  status          SellRequestStatus @default(PENDING)
  adminNotes      String?
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum SellRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
